<?xml version="1.0" encoding="UTF-8"?>
<systemList>
  <!-- Super Nintendo Entertainment System -->
  <system>
    <name>snes</name>
    <fullname>Super Nintendo Entertainment System</fullname>
    <path>%ROMPATH%/data/roms/snes</path>
    <extension>.sfc .smc .zip .SFC .SMC .ZIP</extension>
    <command>pwsh.exe -ExecutionPolicy Bypass -NoProfile -File "%ROMPATH%\scripts\launch.ps1" -Platform snes -RomPath "%ROM%"</command>
    <platform>snes</platform>
    <theme>snes</theme>
  </system>

  <!-- Sony PlayStation 1 -->
