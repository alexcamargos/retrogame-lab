<?xml version="1.0" encoding="UTF-8"?>
<systemList>
  <!--
    CONFIGURACAO DE ROTAS DO FRONTEND ES-DE (EmulationStation Desktop Edition)
    ==========================================================================
    DIRETRIZ OBRIGATORIA DE SELECAO DA PASTA DE ROMS:
    No assistente de primeiro inicio do ES-DE (ou no menu Settings > ROM Directory),
    aponte o diretorio de ROMs estritamente para a RAIZ DO REPOSITORIO (retrogame-lab),
    e NUNCA para a subpasta "data/roms".
    Isso permite que as macros "%ROMPATH%/data/roms/<plataforma>" e o script
    "%ROMPATH%\scripts\launch.ps1" sejam localizados de forma estatica e portatil.
  -->

  <!-- Super Nintendo Entertainment System -->
  <system>
    <name>snes</name>
    <fullname>Super Nintendo Entertainment System</fullname>
    <path>%ROMPATH%/data/roms/snes</path>
    <extension>.sfc .smc .zip .SFC .SMC .ZIP</extension>
    <command>pwsh.exe -ExecutionPolicy Bypass -NoProfile -File "%ROMPATH%\scripts\launch.ps1" -Platform snes -RomPath "%ROM%"</command>
    <platform>snes</platform>
    <theme>snes</theme>
  </system>

  <!-- Sony PlayStation 1 -->
  <system>
    <name>ps1</name>
    <fullname>Sony PlayStation 1</fullname>
    <path>%ROMPATH%/data/roms/ps1</path>
    <extension>.chd .CHD</extension>
    <command>pwsh.exe -ExecutionPolicy Bypass -NoProfile -File "%ROMPATH%\scripts\launch.ps1" -Platform ps1 -RomPath "%ROM%"</command>
    <platform>psx</platform>
    <theme>psx</theme>
  </system>

